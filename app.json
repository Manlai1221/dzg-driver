{
  "expo": {
    "name": "C21 Driver",
    "slug": "driver-app",
    "version": "1.0.2",
    "icon": "./public/appstore.png",
    "orientation": "portrait",
    "scheme": "driverapp",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.manlai.dzgdriver",
      "supportsTablet": true,
      "buildNumber": "3",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./public/appstore.png",
        "backgroundColor": "#000000"
      },
      "package": "mn.shuurkhai.driver"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./public/appstore.png",
          "color": "#000000",
          "sounds": []
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d4b823af-661c-4a5b-8ee8-ae3d3c6c0e52"
      }
    }
  }
}
